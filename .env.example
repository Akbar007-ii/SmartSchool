# Бул файлды .env деп көчүрүп, маанилерин толтуруңуз:  cp .env.example .env

# JWT жана убактылуу сыр сөздөрдү шифрлөө ачкычы. Түзүү:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ЭСКЕРТҮҮ: кийин алмаштырсаңыз бардык токендер жана сакталган убактылуу сыр сөздөр жараксыз болот.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# PostgreSQL (Docker'де DB_HOST жана DB_PORT автоматтык коюлат)
DB_USER=postgres
DB_PASSWORD=
DB_NAME=school
DB_HOST=localhost
DB_PORT=5432

# Фронтенддин даректери (үтүр менен). MVP үчүн * — бардык даректерге уруксат.
CORS_ORIGINS=*

# API кайсы портто ачылат (сервердин тышкы порту)
API_PORT=80
WEB_WORKERS=2

# Почта: сыр сөздү калыбына келтирүү каттары жана билдирүүлөрдүн көчүрмөсү.
# Gmail үчүн: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=сиздин@gmail.com,
# SMTP_PASSWORD — Google аккаунтундагы «App password» (кадимки сыр сөз эмес).
# SMTP_HOST бош болсо, каттар жөнөтүлбөйт — мазмуну API логуна гана жазылат.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Каттагы шилтемелер ушул дарекке жетелейт (фронтенддин дареги, аягында / жок)
FRONTEND_URL=http://localhost:3000
