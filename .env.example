# Бул файлды .env деп көчүрүп, маанилерин толтуруңуз:  cp .env.example .env

# JWT жана убактылуу сыр сөздөрдү шифрлөө ачкычы. Түзүү:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ЭСКЕРТҮҮ: кийин алмаштырсаңыз бардык токендер жана сакталган убактылуу сыр сөздөр жараксыз болот.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# PostgreSQL (Docker'де DB_HOST жана DB_PORT автоматтык коюлат)
DB_USER=postgres
DB_PASSWORD=
DB_NAME=school
DB_HOST=localhost
DB_PORT=5432

# Фронтенддин даректери (үтүр менен). MVP үчүн * — бардык даректерге уруксат.
CORS_ORIGINS=*

# API кайсы портто ачылат (сервердин тышкы порту)
API_PORT=80
WEB_WORKERS=2
